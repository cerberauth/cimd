{
  "client_id": "https://cimd.cerberauth.com/t/pulumi-client.json",
  "client_name": "Pulumi",
  "description": "Pulumi Infrastructure as Code platform with OAuth 2.0 authentication.",
  "identifier": "pulumi",
  "logo_uri": "https://cimd.cerberauth.com/logos/pulumi.svg",
